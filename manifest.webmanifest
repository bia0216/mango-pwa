{
  "name": "Mango Grader",
  "short_name": "Mango",
  "description": "Take or upload a photo of one mango and get its ripeness: unripe, ripe or overripe.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0B140F",
